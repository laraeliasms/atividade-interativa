<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Página Interativa</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #0d0d0f;
      --surface: #17171a;
      --border: #2a2a30;
      --accent: #e8ff47;
      --accent2: #ff6b6b;
      --accent3: #47d4ff;
      --text: #f0f0f0;
      --muted: #6b6b7a;
      --success: #47ffb2;
    }

    body {
      font-family: 'DM Mono', monospace;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      padding: 2rem;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    /* Fundo com grade decorativa */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(var(--border) 1px, transparent 1px),
        linear-gradient(90deg, var(--border) 1px, transparent 1px);
      background-size: 48px 48px;
      opacity: 0.35;
      pointer-events: none;
    }

    header {
      text-align: center;
      margin-bottom: 2.5rem;
      position: relative;
    }

    .eyebrow {
      font-family: 'DM Mono', monospace;
      font-size: 0.7rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 0.6rem;
    }

    h1 {
      font-family: 'Syne', sans-serif;
      font-size: clamp(1.8rem, 5vw, 3rem);
      font-weight: 800;
      line-height: 1.1;
      color: var(--text);
    }

    h1 span { color: var(--accent); }

    .subtitle {
      font-size: 0.75rem;
      color: var(--muted);
      margin-top: 0.6rem;
      letter-spacing: 0.05em;
    }

    /* Layout principal em grade */
    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
      width: 100%;
      max-width: 860px;
      position: relative;
    }

    /* Painel / card */
    .panel {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.4rem;
      position: relative;
      overflow: hidden;
    }

    .panel::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: var(--accent);
      opacity: 0;
      transition: opacity 0.3s;
    }

    .panel:hover::before { opacity: 1; }

    .panel-full { grid-column: 1 / -1; }

    .panel-label {
      font-size: 0.62rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .panel-label::before {
      content: '';
      display: inline-block;
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--accent);
    }

    /* Botões */
    .btn {
      font-family: 'DM Mono', monospace;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      padding: 0.6rem 1.2rem;
      border-radius: 6px;
      border: 1px solid var(--border);
      cursor: pointer;
      transition: all 0.18s ease;
      position: relative;
      overflow: hidden;
    }

    .btn::after {
      content: '';
      position: absolute;
      inset: 0;
      background: white;
      opacity: 0;
      transition: opacity 0.15s;
    }

    .btn:active::after { opacity: 0.08; }

    .btn-primary {
      background: var(--accent);
      color: #0d0d0f;
      border-color: var(--accent);
      font-weight: 500;
    }

    .btn-primary:hover {
      background: #f5ff80;
      transform: translateY(-1px);
      box-shadow: 0 4px 20px rgba(232,255,71,0.25);
    }

    .btn-secondary {
      background: transparent;
      color: var(--muted);
    }

    .btn-secondary:hover {
      border-color: var(--accent2);
      color: var(--accent2);
    }

    .btn-danger {
      background: transparent;
      color: var(--accent2);
      border-color: var(--accent2);
    }

    .btn-danger:hover {
      background: var(--accent2);
      color: white;
      transform: translateY(-1px);
    }

    .btn-info {
      background: transparent;
      color: var(--accent3);
      border-color: var(--accent3);
    }

    .btn-info:hover {
      background: var(--accent3);
      color: #0d0d0f;
    }

    .btn-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }

    /* Caixa de mensagem */
    #mensagem {
      font-family: 'Syne', sans-serif;
      font-size: 1rem;
      font-weight: 600;
      padding: 1rem 1.2rem;
      border-radius: 8px;
      background: rgba(255,255,255,0.04);
      border: 1px solid var(--border);
      min-height: 52px;
      display: flex;
      align-items: center;
      transition: all 0.3s ease;
    }

    #mensagem.highlight {
      color: var(--accent);
      border-color: var(--accent);
      background: rgba(232,255,71,0.06);
      box-shadow: 0 0 24px rgba(232,255,71,0.1);
    }

    #mensagem.danger {
      color: var(--accent2);
      border-color: var(--accent2);
      background: rgba(255,107,107,0.06);
    }

    #mensagem.info {
      color: var(--accent3);
      border-color: var(--accent3);
      background: rgba(71,212,255,0.06);
    }

    #mensagem.success {
      color: var(--success);
      border-color: var(--success);
      background: rgba(71,255,178,0.06);
    }

    /* Input */
    input[type="text"] {
      width: 100%;
      font-family: 'DM Mono', monospace;
      font-size: 0.8rem;
      padding: 0.65rem 1rem;
      background: rgba(255,255,255,0.04);
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--text);
      outline: none;
      transition: border-color 0.2s;
      margin-bottom: 0.7rem;
    }

    input[type="text"]:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(232,255,71,0.1);
    }

    #eco {
      font-size: 0.8rem;
      color: var(--muted);
      min-height: 1.2rem;
      padding: 0.4rem 0;
      transition: color 0.2s;
    }

    #eco.typing { color: var(--success); }

    #keydown-info {
      font-size: 0.75rem;
      color: var(--muted);
      min-height: 1.2rem;
      padding: 0.4rem 0;
    }

    #keydown-info .key {
      display: inline-block;
      background: rgba(255,255,255,0.08);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 0 6px;
      font-size: 0.7rem;
      color: var(--accent);
      margin: 0 2px;
    }

    /* Painel de imagem */
    .img-showcase {
      width: 100%;
      aspect-ratio: 16/7;
      border-radius: 8px;
      overflow: hidden;
      position: relative;
      background: #1a1a20;
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 0.8rem;
      transition: all 0.4s ease;
    }

    .img-inner {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 5rem;
      transition: all 0.35s ease;
      position: absolute;
    }

    .img-inner.hidden-img {
      opacity: 0;
      transform: scale(0.8);
      pointer-events: none;
    }

    /* Badge de evento */
    .event-badge {
      display: inline-block;
      font-size: 0.6rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 2px 8px;
      border-radius: 20px;
      background: rgba(232,255,71,0.12);
      color: var(--accent);
      border: 1px solid rgba(232,255,71,0.2);
      margin-left: 6px;
      vertical-align: middle;
      transition: all 0.2s;
    }

    /* Log de eventos */
    #log {
      list-style: none;
      max-height: 160px;
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--border) transparent;
    }

    #log li {
      font-size: 0.7rem;
      color: var(--muted);
      padding: 4px 0;
      border-bottom: 1px solid rgba(255,255,255,0.04);
      display: flex;
      gap: 8px;
      align-items: baseline;
      animation: fadeIn 0.2s ease;
    }

    #log li .ts {
      color: var(--accent);
      opacity: 0.6;
      flex-shrink: 0;
      font-size: 0.62rem;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-4px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* Mostrar/esconder box */
    #caixa-secreta {
      background: rgba(71,212,255,0.06);
      border: 1px solid rgba(71,212,255,0.2);
      border-radius: 8px;
      padding: 1rem 1.2rem;
      font-size: 0.82rem;
      color: var(--accent3);
      margin-top: 0.8rem;
      transition: all 0.35s ease;
      overflow: hidden;
    }

    #caixa-secreta.escondida {
      max-height: 0;
      padding-top: 0;
      padding-bottom: 0;
      opacity: 0;
      border-color: transparent;
      margin-top: 0;
    }

    #caixa-secreta:not(.escondida) {
      max-height: 120px;
    }

    /* Contador de duplo clique */
    .counter-display {
      font-family: 'Syne', sans-serif;
      font-size: 2.5rem;
      font-weight: 800;
      color: var(--accent);
      text-align: center;
      line-height: 1;
      margin: 0.5rem 0;
      transition: transform 0.1s;
    }

    .counter-display.bump {
      transform: scale(1.15);
    }

    .counter-label {
      font-size: 0.65rem;
      color: var(--muted);
      text-align: center;
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }

    footer {
      margin-top: 2rem;
      font-size: 0.65rem;
      color: var(--muted);
      letter-spacing: 0.1em;
      text-align: center;
    }
  </style>
</head>
<body>

<header>
  <p class="eyebrow">JavaScript Interativo</p>
  <h1>DOM <span>&amp;</span> Eventos</h1>
  <p class="subtitle">// manipulação · eventos · feedback dinâmico</p>
</header>

<div class="grid">

  <!-- 1. Manipulação de DOM + Eventos de clique e mouseover -->
  <div class="panel">
    <div class="panel-label">Manipulação do DOM</div>

    <div class="btn-row">
      <button class="btn btn-primary" id="btnClique">Clique aqui</button>
      <button class="btn btn-info"    id="btnDblClique" title="Tente dar dois cliques rápidos!">Duplo clique</button>
      <button class="btn btn-danger"  id="btnReset">Resetar</button>
    </div>

    <p id="mensagem">Mensagem inicial</p>
  </div>

  <!-- 2. Contador de duplo clique -->
  <div class="panel">
    <div class="panel-label">Evento — dblclick</div>
    <div class="counter-display" id="contador">0</div>
    <div class="counter-label">duplos cliques</div>
    <p style="font-size:0.7rem;color:var(--muted);margin-top:0.8rem;">
      Dê dois cliques rápidos no botão <strong style="color:var(--accent3)">Duplo clique</strong> ao lado para incrementar.
    </p>
  </div>

  <!-- 3. Teclado: keyup + keydown -->
  <div class="panel">
    <div class="panel-label">Eventos de Teclado</div>
    <input type="text" id="campoTexto" placeholder="Digite algo aqui...">
    <p id="eco">// aguardando digitação...</p>
    <p id="keydown-info">// última tecla pressionada: —</p>
  </div>

  <!-- 4. Mostrar / Esconder elemento -->
  <div class="panel">
    <div class="panel-label">Esconder / Mostrar</div>
    <button class="btn btn-secondary" id="btnToggle" style="margin-bottom:0.4rem">Mostrar segredo</button>
    <div id="caixa-secreta" class="escondida">
      ✦ Você descobriu o elemento escondido!<br>
      <small style="opacity:0.6">Isso é <code>display</code> / <code>max-height</code> com transição CSS controlada por JS.</small>
    </div>
  </div>

  <!-- 5. Mudar imagem -->
  <div class="panel panel-full">
    <div class="panel-label">Mudar imagem / estado visual</div>
    <div class="img-showcase" id="imgBox">
      <div class="img-inner" id="imgAtual">🌿</div>
      <div class="img-inner hidden-img" id="imgProxima">🌊</div>
    </div>
    <div class="btn-row">
      <button class="btn btn-secondary" onclick="mudarImagem('🌿','verde')">🌿 Natureza</button>
      <button class="btn btn-secondary" onclick="mudarImagem('🌊','azul')">🌊 Oceano</button>
      <button class="btn btn-secondary" onclick="mudarImagem('🔥','fogo')">🔥 Fogo</button>
      <button class="btn btn-secondary" onclick="mudarImagem('🌌','cosmos')">🌌 Cosmos</button>
      <button class="btn btn-secondary" onclick="mudarImagem('🦋','borboleta')">🦋 Borboleta</button>
    </div>
  </div>

  <!-- 6. Log de eventos -->
  <div class="panel panel-full">
    <div class="panel-label">Log de Eventos em Tempo Real</div>
    <ul id="log">
      <li><span class="ts">00:00:00</span> Página carregada — aguardando interações...</li>
    </ul>
  </div>

</div>

<footer>Todos os eventos: click · dblclick · mouseover · keyup · keydown · change</footer>

<script>
  // ── Elementos ──────────────────────────────────────────
  const btnClique   = document.getElementById('btnClique');
  const btnDblClique= document.getElementById('btnDblClique');
  const btnReset    = document.getElementById('btnReset');
  const btnToggle   = document.getElementById('btnToggle');
  const mensagem    = document.getElementById('mensagem');
  const campoTexto  = document.getElementById('campoTexto');
  const eco         = document.getElementById('eco');
  const keydownInfo = document.getElementById('keydown-info');
  const log         = document.getElementById('log');
  const contador    = document.getElementById('contador');
  const caixaSecreta= document.getElementById('caixa-secreta');
  const imgAtual    = document.getElementById('imgAtual');
  const imgBox      = document.getElementById('imgBox');

  let contDbl = 0;
  let caixaVisivel = false;

  // ── Utilitários ────────────────────────────────────────
  function agora() {
    return new Date().toLocaleTimeString('pt-BR');
  }

  function registrarEvento(texto, tipo = '') {
    const li = document.createElement('li');
    const cores = { click:'#e8ff47', dblclick:'#47d4ff', mouseover:'#ff6b6b', keyup:'#47ffb2', keydown:'#ffb347', change:'#d47fff' };
    li.innerHTML = `<span class="ts">${agora()}</span><span style="color:${cores[tipo]||'#aaa'}">${texto}</span>`;
    log.prepend(li);
    // Limita a 30 entradas
    while (log.children.length > 30) log.removeChild(log.lastChild);
  }

  function setMensagem(texto, classe) {
    mensagem.textContent = texto;
    mensagem.className = '';
    if (classe) mensagem.classList.add(classe);
  }

  // ── Evento: click ──────────────────────────────────────
  btnClique.addEventListener('click', () => {
    setMensagem('✓ Você clicou no botão!', 'highlight');
    registrarEvento('click → btnClique disparado', 'click');
  });

  // ── Evento: dblclick ───────────────────────────────────
  btnDblClique.addEventListener('dblclick', () => {
    contDbl++;
    contador.textContent = contDbl;
    contador.classList.add('bump');
    setTimeout(() => contador.classList.remove('bump'), 120);
    setMensagem(`⚡ Duplo clique #${contDbl} registrado!`, 'info');
    registrarEvento(`dblclick → contador = ${contDbl}`, 'dblclick');
  });

  // ── Evento: mouseover ──────────────────────────────────
  btnClique.addEventListener('mouseover', () => {
    if (mensagem.textContent === 'Mensagem inicial') {
      setMensagem('👆 O mouse passou sobre o botão...', '');
    }
    registrarEvento('mouseover → btnClique', 'mouseover');
  });

  // ── Evento: keyup ──────────────────────────────────────
  campoTexto.addEventListener('keyup', () => {
    const val = campoTexto.value;
    if (val) {
      eco.textContent = '// você digitou: "' + val + '"';
      eco.className = 'typing';
    } else {
      eco.textContent = '// aguardando digitação...';
      eco.className = '';
    }
    registrarEvento(`keyup → "${val}"`, 'keyup');
  });

  // ── Evento: keydown ────────────────────────────────────
  campoTexto.addEventListener('keydown', (e) => {
    keydownInfo.innerHTML = `// última tecla: <span class="key">${e.key}</span> <span style="color:var(--muted);font-size:0.62rem">(code: ${e.code})</span>`;
    registrarEvento(`keydown → key="${e.key}" code="${e.code}"`, 'keydown');
  });

  // ── Reset ──────────────────────────────────────────────
  btnReset.addEventListener('click', () => {
    setMensagem('Mensagem inicial', '');
    eco.textContent = '// aguardando digitação...';
    eco.className = '';
    keydownInfo.innerHTML = '// última tecla pressionada: —';
    campoTexto.value = '';
    contDbl = 0;
    contador.textContent = '0';
    registrarEvento('click → RESET disparado — estado restaurado', 'click');
  });

  // ── Mostrar / Esconder ─────────────────────────────────
  btnToggle.addEventListener('click', () => {
    caixaVisivel = !caixaVisivel;
    caixaSecreta.classList.toggle('escondida', !caixaVisivel);
    btnToggle.textContent = caixaVisivel ? 'Esconder segredo' : 'Mostrar segredo';
    setMensagem(caixaVisivel ? '👁 Elemento revelado!' : '🙈 Elemento escondido!', caixaVisivel ? 'success' : '');
    registrarEvento(`click → caixa ${caixaVisivel ? 'mostrada' : 'escondida'}`, 'click');
  });

  // ── Mudar imagem ───────────────────────────────────────
  const temasBg = {
    verde: '#0d2b1a',
    azul:  '#0d1b2b',
    fogo:  '#2b0d0d',
    cosmos:'#0d0d1f',
    borboleta: '#1f0d2b'
  };

  function mudarImagem(emoji, tema) {
    imgAtual.style.opacity = '0';
    imgAtual.style.transform = 'scale(0.8)';
    setTimeout(() => {
      imgAtual.textContent = emoji;
      imgAtual.style.opacity = '1';
      imgAtual.style.transform = 'scale(1)';
    }, 300);
    imgBox.style.background = temasBg[tema] || '#1a1a20';
    setMensagem(`🖼 Imagem alterada para: ${emoji}`, 'success');
    registrarEvento(`change → imagem trocada para "${emoji}" (tema: ${tema})`, 'change');
  }
</script>

</body>
</html>
